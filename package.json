{
  "name": "lumovi-design",
  "private": true,
  "version": "1.0.0",
  "description": "Lumovi's brand: the logo, app icons, colors, typography and media for the app, the website and the docs.",
  "license": "Apache-2.0",
  "author": "Lumovi contributors",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:vector": "node scripts/build.ts --vector",
    "check": "node scripts/build.ts --check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run check"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.0.0",
    "fontkit": "^2.0.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wawoff2": "^2.0.1"
  },
  "allowScripts": {
    "sharp": false
  }
}
